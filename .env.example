# ==============================================================================
# .env.example — commit this file, never commit .env
# Copy to .env and fill in real values before running docker compose up.
#   cp .env.example .env && chmod 600 .env
# ==============================================================================

MONGO_IMAGE=mongo:8.3

COMPOSE_PROJECT_NAME=mongodb
MONGO_CONTAINER_NAME=mongodb
MONGO_HOSTNAME=mongodb

MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_BEFORE_FIRST_BOOT

MONGO_APP_DB=appdb
MONGO_APP_USERNAME=appuser
MONGO_APP_PASSWORD=CHANGE_ME_BEFORE_FIRST_BOOT

MONGO_MONITOR_USERNAME=monitor
MONGO_MONITOR_PASSWORD=CHANGE_ME_BEFORE_FIRST_BOOT

# Bind mounts — data lives next to the compose file by default.
MONGO_DATA_PATH=./data
MONGO_CONFIG_PATH=./config

MONGO_BIND_HOST=127.0.0.1
MONGO_PORT=27017

MONGO_WIREDTIGER_CACHE_GB=1

MEM_LIMIT=2g
MEM_RESERVATION=1g
CPU_LIMIT=2
CPU_RESERVATION=0.5

LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

TZ=UTC
